{
  "schema_version": "0.1.0",
  "package_id": "RXI-CURRICULUM-MASTER-001",
  "package_name": "RXI-Lab Interdisciplinary Engineering and Design Curriculum",
  "status": "draft",
  "design_principles": [
    "outcome_based",
    "project_centered",
    "research_informed",
    "interdisciplinary",
    "portfolio_evidence",
    "human_ai_collaboration",
    "authenticity_and_academic_integrity"
  ],
  "target_learners": {
    "primary_context": "Mainland China students preparing for international academic pathways",
    "age_bands": [
      {
        "id": "AGE-14-16",
        "label": "Early Exploration",
        "focus": "兴趣探索、基础能力、引导式项目"
      },
      {
        "id": "AGE-17-18",
        "label": "Pre-University Preparation",
        "focus": "学科深化、独立项目、研究意识"
      },
      {
        "id": "AGE-18-22",
        "label": "Advanced Academic Preparation",
        "focus": "专业方法、独立研究、复杂项目与学术表达"
      }
    ],
    "adaptation_policy": "Adjust prerequisites, depth, autonomy and assessment by learner readiness; do not equate age with ability."
  },
  "curriculum_architecture": {
    "shared_foundation_course_ids": [
      "RXI-310",
      "RXI-315"
    ],
    "convergence_course_id": "RXI-356",
    "pathway_ids": [
      "PATH-SOFTWARE",
      "PATH-AI",
      "PATH-ROBOTICS",
      "PATH-BUSINESS",
      "PATH-INDUSTRIAL-DESIGN",
      "PATH-HCI"
    ],
    "course_relationship_policy": {
      "reference_by_id": true,
      "inheritance_is_implicit": false,
      "prerequisites_must_be_declared": true,
      "pathway_courses_may_reference_shared_courses": true
    }
  },
  "shared_courses": {
    "RXI-310": {
      "course_id": "RXI-310",
      "title": "Fundamentals of Engineering",
      "title_zh": "工程学基础",
      "course_role": "shared_foundation",
      "purpose": "建立问题定义、系统化分析、工程实践与证据表达的共同基础。",
      "learning_outcomes": [
        "LO-310-01: Define a problem and identify its stakeholders and constraints.",
        "LO-310-02: Decompose a problem into manageable components.",
        "LO-310-03: Use appropriate tools to develop and test a preliminary solution.",
        "LO-310-04: Communicate decisions using evidence and clear reasoning."
      ],
      "module_outline": [
        "Engineering Thinking and Problem Framing",
        "Requirements, Constraints and Stakeholders",
        "Measurement, Evidence and Basic Experimentation",
        "Prototyping, Testing and Iteration",
        "Technical Communication and Project Reflection"
      ],
      "assessment_evidence": [
        "problem_definition",
        "requirements_and_constraints",
        "prototype_or_model",
        "test_record",
        "technical_reflection"
      ],
      "prerequisites": [],
      "status": "proposed"
    },
    "RXI-315": {
      "course_id": "RXI-315",
      "title": "Systems Design and Abstract Modeling",
      "title_zh": "系统设计与抽象建模",
      "course_role": "shared_foundation",
      "purpose": "培养将复杂问题抽象为系统、模型、关系与可验证方案的能力。",
      "learning_outcomes": [
        "LO-315-01: Identify system boundaries, components and relationships.",
        "LO-315-02: Construct an appropriate conceptual or computational model.",
        "LO-315-03: Analyze assumptions, trade-offs and system behavior.",
        "LO-315-04: Validate a model against evidence or defined criteria."
      ],
      "module_outline": [
        "Systems Thinking and Boundary Definition",
        "Abstraction, Representation and Modeling",
        "Dependencies, Feedback and Emergent Behavior",
        "Trade-off Analysis and Decision Models",
        "Model Validation and Design Review"
      ],
      "assessment_evidence": [
        "system_diagram",
        "model_and_assumptions",
        "trade_off_analysis",
        "validation_report"
      ],
      "prerequisites": [
        "RXI-310"
      ],
      "status": "proposed"
    },
    "RXI-356": {
      "course_id": "RXI-356",
      "title": "Applied Convergence of Design and Technology",
      "title_zh": "设计与技术的应用融合",
      "course_role": "interdisciplinary_convergence",
      "purpose": "连接用户需求、技术可行性、设计质量与社会情境，形成跨学科项目能力。",
      "learning_outcomes": [
        "LO-356-01: Integrate human, technical and contextual requirements.",
        "LO-356-02: Compare alternative design approaches.",
        "LO-356-03: Develop and evaluate an interdisciplinary prototype.",
        "LO-356-04: Explain design decisions to technical and nontechnical audiences."
      ],
      "module_outline": [
        "Design Research and Opportunity Framing",
        "Technology Affordances and Constraints",
        "Cross-Disciplinary Concept Development",
        "Prototype Integration and User or Stakeholder Evaluation",
        "Final Demonstration and Critical Reflection"
      ],
      "assessment_evidence": [
        "research_brief",
        "design_rationale",
        "integrated_prototype",
        "evaluation_evidence",
        "final_presentation"
      ],
      "prerequisites": [
        "RXI-310",
        "RXI-315"
      ],
      "status": "proposed"
    }
  },
  "pathways": {
    "PATH-SOFTWARE": {

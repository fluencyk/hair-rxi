      "title": "Modern Software Development",
      "title_zh": "现代软件开发与工程实践",
      "academic_orientation": [
        "computer_science",
        "software_engineering",
        "human_centered_computing"
      ],
      "purpose": "从程序设计发展到能够定义需求、设计架构、实现、测试并解释软件系统的工程能力。",
      "shared_course_refs": [
        "RXI-310",
        "RXI-315",
        "RXI-356"
      ],
      "competency_map": [
        "programming_and_computational_thinking",
        "data_and_software_architecture",
        "web_and_interactive_systems",
        "testing_and_quality",
        "version_control_and_collaboration",
        "ai_augmented_development",
        "technical_communication"
      ],
      "module_outline": [
        "Applied Programming for Human-Centered Problem Solving",
        "Data Structures, APIs and Application Architecture",
        "Advanced Web Engineering and Interactive Systems",
        "Software Engineering, Testing and Agile Practice",
        "AI-Augmented Software Development",
        "Integrated Software Project"
      ],
      "signature_project": {
        "title": "A User-Centered Software System",
        "description": "针对真实或明确界定的问题开发可运行的软件原型，并以需求、测试和用户反馈验证设计。",
        "deliverables": [
          "problem_and_requirements_brief",
          "architecture_diagram",

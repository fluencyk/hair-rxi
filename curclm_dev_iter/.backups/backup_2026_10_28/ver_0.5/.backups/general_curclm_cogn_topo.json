  "cross_pathway_capabilities": {
    "capability_ids": [
      "CAP-PROBLEM-FRAMING",
      "CAP-RESEARCH",
      "CAP-SYSTEMS-THINKING",
      "CAP-PROTOTYPING",
      "CAP-EVALUATION",
      "CAP-COMMUNICATION",
      "CAP-ETHICS",
      "CAP-COLLABORATION"
    ],
    "policy": "Each pathway must demonstrate relevant shared capabilities through its own discipline-specific work; identical assessment artifacts are not required."
  },
  "academic_evidence_framework": {
    "purpose": "Support truthful academic development and portfolio presentation, not manufacture research credentials.",
    "evidence_types": [
      "problem_and_research_question",
      "literature_or_source_review",
      "method_and_design_rationale",
      "data_or_experiment_record",
      "prototype_or_implementation",
      "evaluation_results",
      "limitations_and_reflection",
      "presentation_or_poster"
    ],
    "provenance_fields": [
      "student_contribution",
      "instructor_guidance",
      "ai_assistance",
      "external_sources",
      "collaborator_contributions"
    ],
    "integrity_rules": [
      "Do not fabricate experiments, data, participants or findings.",
      "Distinguish coursework, independent projects and genuine research.",
      "Disclose AI assistance according to applicable course and application rules.",
      "Do not present a prototype as a validated product or a class project as peer-reviewed research.",
      "Preserve evidence of iteration, decision-making and individual contribution."
    ]
  },
  "validation_rules": [
    {
      "rule_id": "VAL-001",
      "description": "Every pathway reference must resolve to an existing shared course or pathway course.",
      "severity": "error"
    },
    {
      "rule_id": "VAL-002",
      "description": "Every course must define a purpose and measurable learning outcomes.",
      "severity": "error"
    },
    {
      "rule_id": "VAL-003",
      "description": "Every signature project must map to learning outcomes and observable evidence.",
      "severity": "error"
    },
    {
      "rule_id": "VAL-004",
      "description": "Prerequisite references must resolve and must not create unintended dependency cycles.",
      "severity": "error"
    },
    {
      "rule_id": "VAL-005",
      "description": "Age-band adaptations must change scaffolding and depth without making unsupported claims about student ability.",
      "severity": "warning"
    },
    {
      "rule_id": "VAL-006",
      "description": "External claims, datasets, images and references must carry appropriate provenance.",
      "severity": "error"
    }
  ],
  "publication_targets": {
    "primary_output": "structured_html",
    "secondary_outputs": [
      "course_overview",
      "course_outline",
      "project_brief",
      "portfolio_evidence_guide"
    ],
    "human_review_required": true,
    "compiler_must_preserve": [
      "course_ids",
      "learning_outcomes",
      "prerequisites",
      "evidence_requirements",
      "provenance",
      "validation_warnings"
    ]
  }
}